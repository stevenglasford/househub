# Household Hub configuration
#
# Copy to server/.env and edit, or set these in your systemd unit / pm2 config.
# Everything here has a working default — the app runs with no .env at all.
# Nothing in this file needs to be edited again when you deploy a new version.

# ---------- server ----------
# Port the Node server listens on (put a reverse proxy in front for HTTPS)
PORT=4000
# Interface to bind. 127.0.0.1 restricts to the local machine (use this if a
# reverse proxy sits in front); 0.0.0.0 accepts connections from the network.
HOST=0.0.0.0
# How often the server re-fetches subscribed calendar feeds, in minutes
REFRESH_MINUTES=15
# Give up on an unresponsive calendar feed after this many milliseconds
ICS_FETCH_TIMEOUT_MS=15000
# Max request body size (calendar ICS uploads can be large)
BODY_LIMIT=5mb
# Set the server's timezone so calendar feed times display correctly
TZ=America/Chicago

# ---------- storage ----------
# SQLite database file (better-sqlite3, WAL mode). Relative paths resolve
# against the server/ directory. THIS IS YOUR DATA — back it up.
DB_FILE=./hub.db
# Legacy JSON store. If DB_FILE is empty/new on boot and this file exists, it
# is imported once and renamed to data.json.imported. Safe to leave commented.
#DATA_FILE=./data.json
# Where the built frontend lives (written by `npm run build`)
#PUBLIC_DIR=./public

# ---------- Home Assistant (optional) ----------
# Read-only integration for the Home tab (entity states + camera snapshots).
# The token stays on the server and is never sent to the browser. Leave both
# unset and the Home tab simply shows nothing to configure.
# Generate a long-lived access token at your HA profile page (/profile).
#HA_URL=http://192.168.1.50:8123
#HA_TOKEN=

# ---------- first-run seed ----------
# These apply ONLY when creating a brand-new database. Once the hub has data,
# edit names and locations in the app's Settings screen instead.
HOUSEHOLD_NAME=Our Household
# Members as "Name:#hexcolor", comma-separated. Color is optional.
#HOUSEHOLD_PEOPLE=Alex:#2E9187,Sam:#E86A4C
# Default grocery stores for a fresh install (comma-separated)
#GROCERY_STORES=Costco,Aldi,Target

# ---------- weather ----------
# Default map location for the weather card (changeable in Settings later).
WEATHER_LAT=44.98
WEATHER_LON=-93.27
WEATHER_LABEL=Minneapolis
# f or c
WEATHER_UNIT=f
# Set to false to hide the weather card entirely
WEATHER_ENABLED=true
# Weather provider endpoints. Open-Meteo needs no API key. Override these to
# point at a self-hosted or alternative provider.
#WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast
#GEOCODE_API_BASE=https://geocoding-api.open-meteo.com/v1/search

# ---------- display defaults ----------
# auto | wall | compact
DEFAULT_LAYOUT_MODE=auto
# overlay | row | off
DEFAULT_NOTE_DISPLAY=overlay
# Show the per-person summary row on the Today screen
DEFAULT_SHOW_BREAKDOWN=true
# How often the browser re-polls the server, in seconds
CLIENT_POLL_SECONDS=60
