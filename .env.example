# Under pm2, env lives in ecosystem.config.cjs — that's the source of truth.
# For a manual run:  cp .env.example server/.env && node --env-file=.env server.js
# Port the Node server listens on (put a reverse proxy in front for HTTPS)
PORT=4000
# How often the server re-fetches subscribed calendar feeds, in minutes
REFRESH_MINUTES=15
# SQLite database file (better-sqlite3, WAL mode)
DB_FILE=./hub.db
# Legacy JSON store — read once on first boot and imported into the DB
#DATA_FILE=./data.json
# Set the server's timezone so calendar feed times display correctly
TZ=America/Chicago
