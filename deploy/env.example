# Copy to .env at the repository root, then edit.
#
#   cp deploy/env.example .env
#   ./scripts/generate-secret.sh >> .env
#
# Only the first three lines have to change for a working install.

# ---------------------------------------------------------------- required ---

# The URL people will actually type. Used for cookie scoping, the CSRF origin
# check, and the links printed into invitations and display setup QR codes --
# so it must match, including any reverse-proxy path prefix.
PUBLIC_URL=https://hub.example.com

POSTGRES_PASSWORD=change-me-to-something-long

# 32 random bytes, base64. Generate with scripts/generate-secret.sh.
#
# BACK THIS UP. It seals email addresses, TOTP secrets, calendar subscription
# URLs and wallet configuration. Losing it does NOT lose household content --
# that is encrypted under members' own keys -- but it does make those
# server-side values unrecoverable.
SECRET_KEY=

# ---------------------------------------------------------------- optional ---

TZ=America/Chicago

# Host port the app binds to, on loopback only. Change it if something else
# (an older HouseHub, say) already holds 4000.
APP_PORT=4000

# Set to 0 once your household has signed up, to stop strangers registering.
ALLOW_SIGNUP=1

# 1 when running behind Caddy/nginx. Leave 0 otherwise: trusting forwarding
# headers with no proxy in front lets anyone spoof their address past every
# per-IP rate limit.
TRUST_PROXY=1

# ---------------------------------------------------------------------- AI ---

AI_ENABLED=1
# llama3.2:3b runs on a CPU-only box. qwen3:14b is noticeably better on a
# machine with a GPU; qwen2.5-coder:32b is overkill for one-line questions.
OLLAMA_MODEL=llama3.2:3b
# Keeps the model resident so the nightly check-in is instant rather than
# paying a 15-30s cold load. Costs memory.
OLLAMA_KEEP_WARM=1

# ----------------------------------------------------------------- billing ---
# Only for operators charging other families to use their server.
# Read docs/SELF-HOSTING.md first. Receive-only keys ONLY -- never a spending key.

BILLING_ENABLED=0
# Exchange rates. Any endpoint returning CoinGecko's simple-price shape works.
# PRICE_FEED_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,monero&vs_currencies=usd

# ---------------------------------------------------------------- upgrades ---
# The zip -> Claude Code -> pull request pipeline. Needs the `claude` CLI on the
# host and a GitHub token. Opens a PR for review; it does not deploy.

UPGRADES_ENABLED=0
# UPGRADE_REPO_URL=https://github.com/stevenglasford/househub
# GITHUB_TOKEN=
# Leave this off. On means AI-authored changes land on main with nobody reading them.
UPGRADE_DIRECT_PUSH=0

# --------------------------------------------------------- home assistant ----

# HA_URL=http://192.168.1.50:8123
# HA_TOKEN=

# --------------------------------------------------------------- timezone ----
# Fallback zone for households that have not chosen one of their own. Per
# household is the real setting (Settings -> Household -> Timezone); this only
# decides what a household gets before anyone picks.
#
# It matters because the server expands subscribed .ics feeds into calendar days,
# and a host left on UTC pushes evening events onto the following day. Nothing
# errors -- the calendar is just quietly wrong.

HOUSEHOLD_TZ=America/Chicago

# ------------------------------------------------------- phone reminders -----
# Hosts a household may send phone reminders to, e.g. an ntfy instance you run.
# Empty by default, which means the feature cannot be used at all.
#
# The browser sends these itself, because this server cannot read the household
# document and so has no idea what any reminder says. See docs/REMINDERS.md.
#
# Understand the cost before setting it: connect-src is part of what stops
# injected script from posting key material somewhere useful to an attacker, and
# every host here is one more place it could post to. Exact origins only --
# wildcards and plain http are refused at boot.

# PUSH_HOSTS=https://ntfy.example.com
