# Serving the hub as a subpath of an existing site (e.g. https://example.com/hub)
# instead of its own hostname. Drop these two blocks into your existing
# server {} alongside your other apps.
#
# The trailing slash on proxy_pass strips the /hub/ prefix before the request
# reaches Node, and the built frontend + API client use relative URLs, so the
# app itself needs no base-path configuration.

location = /hub { return 301 /hub/; }

location /hub/ {
    proxy_pass         http://127.0.0.1:4000/;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
}
